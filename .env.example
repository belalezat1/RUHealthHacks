# Copy to .env (never commit .env). Compose reads it automatically.

# local = demo accounts listed on the login page, password "sevaro-demo"
# hosted = HTTPS-only cookies, origin checks, password required
SEVARO_MODE=local

# Required in hosted mode (12+ characters). Shared by all demo accounts.
SEVARO_DEMO_PASSWORD=

# Required in hosted mode: the CloudFront URL viewers use, e.g. https://d111111abcdef8.cloudfront.net
SEVARO_ALLOWED_ORIGINS=

# Where SQLite lives on the host. On AWS: /srv/sevaro/state (EBS volume).
SEVARO_STATE_PATH=./state

# Git SHA baked into images and shown in the UI.
RELEASE_SHA=dev
WEB_PORT=8080
