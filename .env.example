# Local synthetic demo only. Never commit a populated .env.
APP_ENV=local
AUTH_MODE=demo
POSTGRES_PASSWORD=sevaro-local-only
DATABASE_URL=postgresql+psycopg://sevaro:sevaro-local-only@localhost:5432/sevaro
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DEMO_POLICY_PATH=../config/demo_policies.json
AWS_REGION=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# Only live mode requires a confirmed sponsor/project key, kept server-side.
JEV_MODE=mock
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
JEV_TIMEOUT_SECONDS=5
JEV_MAX_RETRIES=1
FORECAST_HORIZON_MINUTES=90
FORECAST_INTERVAL_MINUTES=15
MAX_SOLVER_SECONDS=0.25

# Public frontend configuration; set before building for a hosted deployment.
VITE_API_BASE_URL=/v1
VITE_PROXY_TARGET=http://127.0.0.1:8000
