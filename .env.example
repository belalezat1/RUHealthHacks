# TypeSafe / Jev API key; keep this server-side.
TYPESAFE_API_KEY=

# Default local database: postgresql://<your OS user>@127.0.0.1:55433/sevaro
# SEVARO_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/sevaro
SEVARO_MODE=local
SEVARO_POLICY_MODE=challenge
SEVARO_AUTO_MIGRATE=true
SEVARO_JEV_MODEL=jev-latest
SEVARO_JEV_DEADLINE_MS=900
SEVARO_JEV_CONFIDENCE=0.75
# Optional local Docker Compose database password: use a unique alphanumeric value.
SEVARO_LOCAL_DB_PASSWORD=
SEVARO_LOCAL_WEB_PORT=8080
# Hosted mode also requires explicit trusted origins and identity configuration.
# SEVARO_ALLOWED_ORIGINS=https://your-approved-host
# SEVARO_IDENTITY_MODE=provisioned_sessions
