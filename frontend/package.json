{
  "name": "sevaro-command-center",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview --host 0.0.0.0",
    "generate:api": "openapi-typescript ../docs/openapi.json -o src/api/generated.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e playwright.config.ts vite.config.ts",
    "format:check": "prettier --check src e2e playwright.config.ts vite.config.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.16",
    "@tanstack/react-query": "5.90.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-router-dom": "7.9.4",
    "recharts": "3.3.0",
    "tailwindcss": "4.1.16"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "openapi-typescript": "7.9.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  }
}
